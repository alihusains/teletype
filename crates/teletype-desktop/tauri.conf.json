{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teletype",
  "version": "0.2.2",
  "identifier": "com.teletype.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Teletype",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      },
      {
        "label": "pill",
        "title": "Teletype Recorder",
        "url": "pill.html",
        "width": 520,
        "height": 84,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visibleOnAllWorkspaces": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon-512.png",
      "icons/icon-1024.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/llama-server": "llama-server"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxNUMyRTYzODE5MEIwOEMKUldTTXNKQ0JZeTVjc1NMUVlGMkttYnJsS1RsVmlDRWgrQ29qa2loL1BLWmUzbzZ4cklGSzJ1NncK",
      "endpoints": [
        "https://github.com/alihusains/teletype/releases/latest/download/latest.json"
      ]
    }
  }
}