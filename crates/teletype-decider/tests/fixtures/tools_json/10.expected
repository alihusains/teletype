[{"name": "open_app", "description": "Open an application by name.", "parameters": {"type": "object", "properties": {"app": {"type": "string", "enum": ["terminal", "safari", "notes", "mail", "finder", "code"]}}, "required": ["app"]}}, {"name": "web_search", "description": "Search the web for a query.", "parameters": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}}, {"name": "transform_selection", "description": "Transform the current text selection.", "parameters": {"type": "object", "properties": {"transform": {"type": "string", "enum": ["uppercase", "lowercase", "titlecase", "capitalize"]}, "language": {"type": "string", "enum": ["en", "fr", "de", "ja"]}}, "required": ["transform"]}}, {"name": "insert_autotext", "description": "Insert a saved autotext snippet.", "parameters": {"type": "object", "properties": {"snippet": {"type": "string", "enum": ["thanks", "regards", "br", "signature"]}}, "required": ["snippet"]}}, {"name": "switch_style", "description": "Switch the current text style.", "parameters": {"type": "object", "properties": {"style": {"type": "string", "enum": ["body", "heading", "code"]}}, "required": ["style"]}}, {"name": "draft_message", "description": "Draft a message to a recipient.", "parameters": {"type": "object", "properties": {"recipient": {"type": "string"}, "body": {"type": "string"}}, "required": ["recipient", "body"]}}, {"name": "media", "description": "Control media playback.", "parameters": {"type": "object", "properties": {"action": {"type": "string", "enum": ["play_pause", "next", "previous", "volume_up", "volume_down", "mute"]}}, "required": ["action"]}}, {"name": "edit_text", "description": "Edit the surrounding text.", "parameters": {"type": "object", "properties": {"action": {"type": "string", "enum": ["undo_last_dictation", "delete_last_sentence", "new_line", "new_paragraph", "select_all"]}}, "required": ["action"]}}, {"name": "paste_last", "description": "Paste the last dictated text.", "parameters": {"type": "object", "properties": {}}}, {"name": "no_action", "description": "Do nothing.", "parameters": {"type": "object", "properties": {}}}]