[{"name": "verbose_tool", "description": "This tool does a lot of things. First it does one thing, then it does another thing, and finally it does a third thing that is closely related to the first two. It is described in detail because the NeuDecide model encodes the serialized tool list into its context, so longer descriptions cost tokens but may improve disambiguation between similar tools. Second paragraph: the description may span multiple sentences and contain punctuation such as (parentheses), [brackets], {braces}, and a slash in a path like /usr/local/bin/tool. Third paragraph: unicode accents \u00e9\u00e0\u00fc and symbols \u00a9\u00ae\u2122 are escaped as \\u sequences in the serialized form.", "parameters": {"type": "object", "properties": {"option": {"type": "string", "enum": ["one", "two", "three"]}}}}]